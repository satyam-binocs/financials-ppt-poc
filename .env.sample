LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PLANNING_MODEL=
VISUAL_REVIEW_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_VERSION=2023-06-01
LLM_TIMEOUT_SECONDS=90
MAX_SLIDE_REPAIR_ATTEMPTS=3
MAX_LLM_RETRIES=2
MAX_LLM_REQUESTS_PER_RUN=32
MAX_LLM_TOKENS_PER_RUN=200000
MAX_LLM_OUTPUT_TOKENS_PER_CALL=2000
MAX_LLM_ESTIMATED_COST_USD_PER_RUN=5.00
# Update these prices if PLANNING_MODEL changes. Defaults below match gpt-5.6-terra as of 2026-09-14.
PLANNING_INPUT_COST_PER_1M_TOKENS=2.00
PLANNING_OUTPUT_COST_PER_1M_TOKENS=12.00
LLM_CONCURRENCY=4
PRESENTATION_ASPECT_RATIO=16:9
DEFAULT_LOCALE=en-US
OUTPUT_DIRECTORY=./output
BUILD_DIRECTORY=./build
ENABLE_LLM_VISUAL_REVIEW=true
VISUAL_REVIEW_BATCH_SIZE=3
MIN_VISUAL_AESTHETIC_SCORE=7
MIN_VISUAL_READABILITY_SCORE=8
MIN_VISUAL_BALANCE_SCORE=7
ENABLE_LLM_PLANNING=true
ENABLE_LLM_CACHE=true
ENABLE_DETERMINISTIC_FALLBACK=false
ENABLE_SPEAKER_NOTE_CITATIONS=true
STRICT_VALIDATION=true
